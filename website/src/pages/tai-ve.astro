---
import Trang from '../layouts/Trang.astro';
import { banMoiNhat, lenhCai, mb, REPO_URL } from '../lib/noi-dung';

const ban = await banMoiNhat();
const lenh = await lenhCai();
const nhomHe = (['Windows', 'macOS', 'Linux'] as const).filter((h) => lenh.some((l) => l.heDieuHanh === h));
const TEN_LOAI = {
  exe: { t: 'Bộ cài NSIS (.exe)', d: 'Khuyên dùng. Hỗ trợ tự cập nhật trong ứng dụng.' },
  msi: { t: 'Gói Windows Installer (.msi)', d: 'Cho triển khai hàng loạt qua Group Policy, Intune hoặc SCCM.' },
  cli: { t: 'Bản dòng lệnh (.exe)', d: 'Một tệp, không cần cài. Xem trang Dòng lệnh.' },
} as const;
const exe = ban.goi.find((g) => g.loai === 'exe');
const tenExe = exe?.ten ?? `tsucwico_${ban.phienBan}_windows-x64-setup.exe`;
---
<Trang tieuDe="Tải về" moTa="Tải Tsu Cwico cho Windows 10 và 11: bộ cài .exe, gói .msi hoặc winget; kèm mã SHA-256 để kiểm tra tệp và hướng dẫn chạy lần đầu an toàn." duongDan="/tai-ve/">
  <div class="khung tai-lieu">
    <nav class="tai-lieu__menu" aria-label="Tải về">
      <p>Tải về</p>
      <ul>
        <li><a href="#cai-bang-lenh">Cài bằng lệnh</a></li>
        <li><a href="#chon-goi">Bộ cài</a></li>
        <li><a href="#kiem-tra">Kiểm tra tệp</a></li>
        <li><a href="#lan-dau">Chạy lần đầu</a></li>
        <li><a href="#cap-nhat">Cập nhật</a></li>
      </ul>
    </nav>
    <article class="van-ban">
      <h1>Tải Tsu Cwico {ban.phienBan}</h1>
      <p>Phát hành ngày {ban.ngay}. Mọi gói được build tự động trên GitHub Actions từ mã nguồn công khai; trang này chỉ dẫn tới <a href={ban.url} target="_blank" rel="noopener noreferrer">trang phát hành trên GitHub</a>, không lưu bản sao.</p>

      <h2 id="cai-bang-lenh">Cài bằng lệnh</h2>
      <p>Trình quản lý gói tự so SHA-256 của tệp tải về với mã ghi trong kho gói trước khi cài. Bấm <strong>Chép</strong> rồi dán vào Terminal hoặc PowerShell.</p>
      {nhomHe.map((h) => (
        <div class="cai-lenh">
          <h3>{h}</h3>
          {lenh.filter((l) => l.heDieuHanh === h).map((l) => (
            <div class="cai-lenh__muc">
              <p class="cai-lenh__kenh">{l.kenh}</p>
              <div class="cai-lenh__dong">
                <pre tabindex="0"><code>{l.lenh.join('\n')}</code></pre>
                <button type="button" class="nut nut--phu nut--nho" data-chep={l.lenh.join('\n')} aria-label={`Chép lệnh ${l.kenh}`}>Chép</button>
              </div>
            </div>
          ))}
        </div>
      ))}
      <p>Gói winget nằm trong kho chính thức <a href="https://github.com/microsoft/winget-pkgs/tree/master/manifests/t/tsudev/cwico" target="_blank" rel="noopener noreferrer">microsoft/winget-pkgs</a>; danh sách kênh lấy từ catalog của các kho gói tsudev lúc build.</p>

      <h2 id="chon-goi">Tải bộ cài</h2>
      <div class="goi">
        {ban.goi.map((g) => (
          <div class="goi__muc">
            <div>
              <h3>{TEN_LOAI[g.loai].t}</h3>
              <p class="goi__ten">{g.ten} · {mb(g.kichThuoc)} · {TEN_LOAI[g.loai].d}</p>
            </div>
            <a class={`nut ${g.loai === 'exe' ? 'nut--chinh' : 'nut--phu'}`} href={g.url}>Tải về</a>
            {g.sha256 && <p class="goi__bam">SHA-256: {g.sha256}</p>}
          </div>
        ))}
      </div>
      <p>Chỉ có bản 64-bit (x64). Windows 32-bit và Windows trên ARM chưa được hỗ trợ.</p>

      <h2 id="kiem-tra">Kiểm tra tệp trước khi chạy</h2>
      <p>So mã SHA-256 của tệp tải về với mã ở trên. Trong PowerShell:</p>
      <pre tabindex="0"><code>Get-FileHash .\{tenExe} -Algorithm SHA256</code></pre>
      <p>Từ bản 26.11.1901, mỗi bản phát hành còn kèm <code>SHA256SUMS.txt</code> ký không khóa bằng Sigstore (<code>SHA256SUMS.txt.sigstore.json</code>), chứng thực nguồn gốc build của GitHub và SBOM (danh sách thành phần, SPDX). Kiểm tệp được build từ đúng mã nguồn của dự án bằng <a href="https://cli.github.com/" target="_blank" rel="noopener noreferrer">GitHub CLI</a>:</p>
      <pre tabindex="0"><code>gh attestation verify .\{tenExe} --repo tsudev-org/tsucwico</code></pre>
      <div class="chu-y">
        <p><strong>Bộ cài chưa có chữ ký Authenticode.</strong> Windows SmartScreen sẽ cảnh báo ở lần chạy đầu ("Windows protected your PC"). Hãy kiểm tra mã SHA-256 như trên trước, rồi mới chọn <em>More info → Run anyway</em>. Dự án chưa có chứng chỉ ký mã; khi có, trang này sẽ ghi rõ.</p>
        <p><strong>Chỉ tải từ trang này, winget, hoặc <a href={`${REPO_URL}/releases`} target="_blank" rel="noopener noreferrer">GitHub của dự án</a>.</strong> Mọi trang khác tự xưng là "bản chính thức" đều không liên quan.</p>
      </div>

      <h2 id="lan-dau">Chạy lần đầu</h2>
      <ol>
        <li>Chạy Tsu Cwico với quyền <strong>Administrator</strong>. Không có quyền quản trị thì kết quả quét thiếu và không gỡ được gì.</li>
        <li>Nhấn <strong>Quét</strong>. Việc quét chỉ đọc, không thay đổi gì trên máy.</li>
        <li>Chọn các mục muốn gỡ, mở <strong>Kế hoạch</strong> để xem chính xác từng bước sẽ chạy. Mục Trọng yếu không chọn được; mục Cẩn trọng cần xác nhận riêng.</li>
        <li>Khi chạy, Tsu Cwico tạo điểm khôi phục hệ thống và tệp <code>.reg</code> trước. Nếu không tạo được điểm khôi phục, lượt chạy dừng lại trước khi đụng vào bất cứ thứ gì.</li>
      </ol>
      <p>Muốn xem trước mà chắc chắn không thay đổi gì: dùng <a href="/dong-lenh/">dòng lệnh</a> <code>cwico plan</code> - mọi lệnh chỉ chạy thử cho tới khi có <code>--apply</code>.</p>

      <h2 id="cap-nhat">Cập nhật</h2>
      <p>Mỗi lần khởi động, Tsu Cwico kiểm tra bản mới trên GitHub Releases. Nếu <strong>xác nhận</strong> có bản mới, ứng dụng yêu cầu cập nhật trước khi dùng tiếp - vì cơ sở dữ liệu an toàn quyết định thứ gì được phép gỡ, và một bản cũ đang dùng đánh giá an toàn đã lỗi thời. Gói cập nhật được ký; bản đã cài chỉ chấp nhận gói ký bằng đúng khóa của dự án.</p>
      <p>Mất mạng hay GitHub gặp sự cố thì ứng dụng vẫn chạy bình thường: sự cố máy chủ không được khóa mọi người dùng cùng lúc. Lịch sử thay đổi ở trang <a href="/nhat-ky/">Nhật ký</a>.</p>
    </article>
  </div>
  <style>
    .cai-lenh { margin-block: 1rem; }
    .cai-lenh__kenh { margin: .5rem 0 .25rem; font-weight: 600; font-size: .875rem; }
    .cai-lenh__dong { display: flex; gap: .5rem; align-items: flex-start; }
    .cai-lenh__dong pre { flex: 1; min-width: 0; margin: 0; overflow-x: auto; }
  </style>
</Trang>
