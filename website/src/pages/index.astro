---
import Trang from '../layouts/Trang.astro';
import Anh from '../components/Anh.astro';
import { banMoiNhat, CSDL, demLop, REPO_URL, TINH_CHINH, TEN_LOP } from '../lib/noi-dung';

const ban = await banMoiNhat();
const exe = ban.goi.find((g) => g.loai === 'exe');
const dem = demLop();
const tongQuyTac = CSDL.rules.length;

const sauNoi = [
  { t: 'Chương trình đã cài', d: 'Khóa Uninstall ở HKLM và HKCU, đọc cả hai chế độ xem 64-bit và WOW6432Node - không sót phần mềm 32-bit.' },
  { t: 'Ứng dụng UWP / AppX', d: 'Tên gói, nhà phát hành, kiến trúc, đường dẫn cài; phân biệt gói khung và gói hệ thống qua PackageManager.' },
  { t: 'Gói nạp sẵn (provisioned)', d: 'Gói đã nạp vào ảnh Windows, tự cài lại cho mọi tài khoản mới - gỡ thường không hết, Tsu Cwico gỡ tận gốc.' },
  { t: 'Dịch vụ Windows', d: 'Tên hiển thị, trạng thái, kiểu khởi động và ImagePath, đọc trực tiếp từ Service Control Manager.' },
  { t: 'Tác vụ lập lịch', d: 'Đường dẫn đầy đủ, trạng thái bật và đang chạy của từng tác vụ qua COM của Task Scheduler.' },
  { t: 'Khởi động cùng máy', d: 'Run, RunOnce ở cả hai hive, cả hai chế độ xem, cùng thư mục Startup của người dùng và của máy.' },
];
const buocGo = [
  { t: 'Dừng tiến trình', d: 'Tắt tiến trình của phần mềm. Tiến trình dùng chung như svchost.exe và tiến trình trọng yếu khi khởi động không bao giờ bị đụng.' },
  { t: 'Chạy trình gỡ của hãng', d: 'Ưu tiên QuietUninstallString; nếu không có, chỉ tự suy công tắc im lặng cho MSI, Inno Setup và NSIS.' },
  { t: 'Gỡ gói cho mọi người dùng', d: 'Gỡ gói AppX cho tất cả tài khoản, rồi bỏ nạp sẵn để phần mềm không quay lại ở tài khoản mới.' },
  { t: 'Dọn tận gốc', d: 'Thư mục và khóa Registry còn sót - mỗi đường dẫn đều qua bộ chặn xóa ngay trước khi xóa.' },
];
// Mỗi tính năng chính một ảnh (docs/screenshots/), bố cục so le chữ - ảnh. tweaks-dark-vi + ảnh hero chụp trên Windows 11
// thật; các ảnh còn lại là giao diện thật với dữ liệu mẫu (website/scripts/chup-anh.mjs).
const tinhNang = [
  {
    id: 'tn-ke-hoach',
    t: 'Không có gì xảy ra trước khi bạn xem kế hoạch',
    d: 'Kế hoạch gỡ liệt kê từng bước sẽ chạy cho từng mục: sao lưu đi trước, rồi tới tắt tiến trình, trình gỡ của hãng, dọn tàn dư. Mục bị bộ lọc an toàn loại ra vẫn hiện, kèm lý do.',
    anh: 'plan-light-en', rong: 1280, cao: 940,
    alt: 'Kế hoạch gỡ: các bước sao lưu chạy trước, các bước cụ thể cho từng mục, và những mục bị từ chối kèm lý do',
  },
  {
    id: 'tn-can-trong',
    t: 'Mục Cẩn trọng phải xác nhận riêng',
    d: 'Đánh dấu ô chọn chưa đủ: mỗi mục Cẩn trọng mở một hộp thoại nói rõ bạn sẽ mất tính năng gì và khóa Registry nào bị chạm, rồi mới vào kế hoạch.',
    anh: 'caution-dark-vi', rong: 1280, cao: 860,
    alt: 'Hộp thoại xác nhận riêng cho một mục Cẩn trọng, ghi tính năng sẽ mất và khóa Registry liên quan',
  },
  {
    id: 'tn-tinh-chinh',
    t: `${TINH_CHINH.tweaks.length} tinh chỉnh, mục nào cũng hoàn tác được`,
    d: 'Tắt thu thập dữ liệu chẩn đoán, ID quảng cáo, lịch sử hoạt động, nội dung gợi ý trên màn hình khóa… chọn riêng từng mục hoặc dùng bộ khuyến nghị. Mỗi tinh chỉnh ghi mức an toàn và đường hoàn tác.',
    anh: 'tweaks-dark-vi', rong: 1274, cao: 851,
    alt: 'Danh mục tinh chỉnh hệ thống, mỗi mục có mức an toàn và đường hoàn tác',
  },
  {
    id: 'tn-cap-nhat',
    t: 'Cập nhật có chữ ký, không đoán mò',
    d: 'Lúc khởi động, app hỏi GitHub Releases xem có bản mới không - không gửi dữ liệu máy. Gói cập nhật phải khớp chữ ký minisign gắn trong app thì mới được cài.',
    anh: 'update-gate-vi', rong: 1100, cao: 860,
    alt: 'Màn hình cập nhật bắt buộc: đang dùng 26.11.1002, phiên bản mới 26.11.1901, ghi chú thay đổi và nút Cập nhật',
  },
  {
    id: 'tn-gioi-thieu',
    t: 'Biết chính xác lớp bảo vệ nào đang chạy',
    d: 'Bảng Giới thiệu cho thấy phiên bản cơ sở dữ liệu an toàn, số quy tắc từng mức và thư mục chứa tệp .reg hoàn tác - để khi cần, bạn tự khôi phục được.',
    anh: 'about-light-en', rong: 1280, cao: 860,
    alt: 'Bảng Giới thiệu: số quy tắc an toàn đang nạp và nơi lưu tệp hoàn tác',
  },
];

const lop = [
  { k: 'safe', so: dem.safe },
  { k: 'caution', so: dem.caution },
  { k: 'critical', so: dem.critical },
] as const;
---
<Trang moTa="cwico: rà quét sâu và gỡ phần mềm thừa trên Windows - chặn cứng thành phần hệ thống, tạo điểm khôi phục và sao lưu Registry trước mỗi lần chạy." duongDan="/">
  <section class="mo-dau">
    <div class="khung mo-dau__luoi">
      <div>
        <span class="nhan">Phiên bản {ban.phienBan} · {ban.ngay}</span>
        <h1>Gỡ phần mềm thừa trên Windows <span class="chu-tim">mà không làm hỏng máy</span></h1>
        <p class="mo-dau__phu">Tsu Cwico đọc cả sáu nơi Windows giấu phần mềm đã cài, phân loại từng mục kèm lý do, rồi chỉ gỡ những gì bạn đã xem và đồng ý - sau khi đã tạo điểm khôi phục.</p>
        <div class="mo-dau__nut">
          {exe && <a class="nut nut--chinh" href={exe.url}>Tải bộ cài cho Windows (x64)</a>}
          <a class="nut nut--phu" href="/tai-ve/">winget, MSI và kiểm tra tệp</a>
        </div>
        <p class="mo-dau__ghi-chu">Windows 10 và 11 · miễn phí, mã nguồn mở MIT · không tài khoản, không thu thập dữ liệu</p>
      </div>
      <figure class="khung-anh khung-may">
        <div class="khung-may__thanh" aria-hidden="true"><span></span><span></span><span></span></div>
        <Anh ten="scan-light-vi" toi="scan-dark-vi" hero rong={1274} cao={851}
          alt="Kết quả quét thật trên Windows 11: mỗi dòng ghi mức an toàn và lý do, phân trang 10 mục" />
        <figcaption>Mỗi dòng có mức an toàn và <strong>lý do</strong> - không phải rê chuột mới biết.</figcaption>
      </figure>
    </div>
  </section>

  <section class="muc" aria-labelledby="so-lieu">
    <div class="khung">
      <h2 id="so-lieu">Ba lớp bảo vệ giữa bạn và một chiếc máy không khởi động được</h2>
      <p class="muc__dan">Lỗi tệ nhất của một công cụ dọn Windows là máy không lên. Tsu Cwico đặt ba lớp độc lập trước kết cục đó; mỗi lớp đều có kiểm thử tự động chạy trên mọi lần thay đổi mã.</p>
      <ul class="so-lieu">
        <li><strong>{tongQuyTac}</strong><span>quy tắc phân loại</span></li>
        <li><strong>{dem.critical}</strong><span>thành phần bị chặn cứng</span></li>
        <li><strong>{TINH_CHINH.tweaks.length}</strong><span>tinh chỉnh có hoàn tác</span></li>
        <li><strong>0</strong><span>dữ liệu gửi đi</span></li>
      </ul>
      <ol class="lop-bao-ve">
        <li class="the">
          <h3>1. Phân loại</h3>
          <p>Mọi mục được đối chiếu với cơ sở dữ liệu an toàn. Mục không khớp quy tắc nào là <strong>Chưa rõ</strong>, không bao giờ là An toàn; khớp cả An toàn lẫn Trọng yếu thì Trọng yếu thắng.</p>
          <a href="/co-so-du-lieu/">Tra cứu {tongQuyTac} quy tắc</a>
        </li>
        <li class="the">
          <h3>2. Cổng lập kế hoạch</h3>
          <p>Mục Trọng yếu <strong>không thể</strong> đưa vào kế hoạch - không bằng cờ, không bằng xác nhận, không từ dòng lệnh. Mục Cẩn trọng phải xác nhận riêng từng mục.</p>
          <a href="/an-toan/#2-cổng-lập-kế-hoạch---removalplanbuild">Cách cổng hoạt động</a>
        </li>
        <li class="the">
          <h3>3. Bộ chặn xóa</h3>
          <p>Mọi đường dẫn và khóa Registry được kiểm ngay trước khi xóa: gốc ổ đĩa, System32, hồ sơ người dùng, Documents, OneDrive, gốc hive đều bị từ chối thẳng.</p>
          <a href="/an-toan/#3-bộ-chặn-xóa---cwico_coreguard">Danh sách bị chặn</a>
        </li>
      </ol>
      <ul class="lop-an-toan" aria-label="Phân bố quy tắc theo mức">
        {lop.map((l) => (
          <li class={`lop-an-toan__muc lop--${l.k}`}>
            <span class="huy-hieu" data-lop={l.k}>{TEN_LOP[l.k].ten}</span>
            <span><strong>{l.so}</strong> quy tắc - {TEN_LOP[l.k].y}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="muc" aria-labelledby="sau-noi">
    <div class="khung">
      <h2 id="sau-noi">Sáu nơi Windows giấu phần mềm</h2>
      <p class="muc__dan">Trình "Ứng dụng đã cài" của Windows chỉ cho bạn thấy một phần. Tsu Cwico đọc trực tiếp bằng API Win32 và WinRT, không qua PowerShell.</p>
      <ul class="the-luoi">
        {sauNoi.map((x) => <li class="the"><h3>{x.t}</h3><p>{x.d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="muc" aria-labelledby="bon-buoc">
    <div class="khung">
      <h2 id="bon-buoc">Bốn bước gỡ, sau khi đã có đường lui</h2>
      <p class="muc__dan">Trước bước gây thay đổi đầu tiên: tạo <strong>điểm khôi phục hệ thống</strong> (không tạo được thì hủy cả lượt chạy), xuất <strong>.reg</strong> mọi khóa sẽ đụng kèm tệp <code>restore-registry.cmd</code>, và ghi <strong>nhật ký giao dịch</strong> từng bước.</p>
      <ol class="buoc">
        {buocGo.map((x) => <li class="the"><h3>{x.t}</h3><p>{x.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="muc" aria-labelledby="video">
    <div class="khung">
      <h2 id="video">Xem Tsu Cwico chạy trong 90 giây</h2>
      <p class="muc__dan">Quét, lọc theo mức an toàn, xác nhận mục Cẩn trọng, xem kế hoạch, chạy thử, tinh chỉnh - giao diện thật của app, dùng <strong>dữ liệu mẫu</strong> (không phải máy của ai). Có phụ đề tiếng Việt.</p>
      <figure class="khung-video" data-hien>
        <video controls preload="none" playsinline width="1280" height="800"
          poster="/video/gioi-thieu-poster.webp" aria-describedby="video-mo-ta">
          <source src="/video/gioi-thieu.webm" type="video/webm">
          <source src="/video/gioi-thieu.mp4" type="video/mp4">
          <track kind="captions" src="/video/gioi-thieu.vi.vtt" srclang="vi" label="Tiếng Việt" default>
          <a href="/video/gioi-thieu.mp4">Tải video giới thiệu (MP4)</a>
        </video>
        <figcaption id="video-mo-ta">Không có tiếng; phụ đề mô tả từng bước. Video tự lưu trữ trên cwico.tsudev.com, không theo dõi người xem.</figcaption>
      </figure>
    </div>
  </section>

  <section class="muc" aria-labelledby="tinh-nang">
    <div class="khung">
      <h2 id="tinh-nang">Từng bước đều nhìn thấy được</h2>
      <p class="muc__dan">Ảnh quét và tinh chỉnh chụp trên một máy Windows 11 thật; các màn còn lại là giao diện thật của app với dữ liệu mẫu. Ứng dụng song ngữ Việt - Anh, giao diện Sáng / Tối / Theo hệ thống.</p>
      <ul class="so-le">
        {tinhNang.map((x) => (
          <li class="so-le__hang" data-hien aria-labelledby={x.id}>
            <div class="so-le__chu">
              <h3 id={x.id}>{x.t}</h3>
              <p>{x.d}</p>
            </div>
            <figure class="khung-anh">
              <Anh ten={x.anh} alt={x.alt} rong={x.rong} cao={x.cao} />
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="muc" aria-labelledby="nen-tang">
    <div class="khung">
      <h2 id="nen-tang">Nền tảng</h2>
      <ul class="nen-tang">
        <li class="the" data-hien>
          <svg class="nen-tang__icon" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 5.5 10.5 4.5v7H3zm8.5-1.1L21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zm8.5 0H21V21l-9.5-1.4z"/></svg>
          <h3>Windows 10 và 11 (x64)</h3>
          <p>Ứng dụng có giao diện (bộ cài .exe hoặc .msi) và công cụ dòng lệnh <code>cwico.exe</code> dùng chung một bộ máy quét và bộ lọc an toàn. Cài bằng winget, Scoop hoặc tải trực tiếp.</p>
          <a href="/tai-ve/">Tải về và kiểm tra tệp</a>
        </li>
        <li class="the" data-hien>
          <svg class="nen-tang__icon" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.5" d="M4 6h16v11H4zM2 19h20M9 9l-2 2.5L9 14m6-5 2 2.5-2 2.5"/></svg>
          <h3>Dòng lệnh, tự động hóa</h3>
          <p><code>cwico scan --json</code> xuất danh sách để kiểm toán, <code>cwico plan --safe-only</code> xem trước kế hoạch; mọi lệnh chỉ chạy thử cho tới khi có <code>--apply</code>, qua cùng các cổng an toàn như bản có giao diện.</p>
          <a href="/dong-lenh/">Hướng dẫn dòng lệnh</a>
        </li>
      </ul>
      <p class="muc__dan">Tsu Cwico chỉ dành cho Windows - macOS, Linux và điện thoại không có thứ để nó dọn.</p>
    </div>
  </section>

  <section class="muc" aria-labelledby="nguon-goc">
    <div class="khung">
      <h2 id="nguon-goc">Mã nguồn mở, chạy ngoại tuyến</h2>
      <p class="muc__dan">Mã nguồn công khai trên <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a>, giấy phép MIT, viết bằng Rust. Hạng sản phẩm C theo quy ước TsuDEV: không tài khoản, không đăng nhập; yêu cầu mạng duy nhất là kiểm tra bản cập nhật có chữ ký, mất mạng vẫn chạy bình thường.</p>
      <div class="mo-dau__nut">
        <a class="nut nut--phu" href="/an-toan/">Đọc cơ chế an toàn</a>
        <a class="nut nut--phu" href="/dong-lenh/">Dùng từ dòng lệnh</a>
      </div>
    </div>
  </section>
</Trang>
