{
  "schema": 1,
  "name": "tsucwico",
  "winget": "tsudev.cwico",
  "homepage": "https://cwico.tsudev.com",
  "license": "MIT",
  "description": {
    "vi": "Bộ công cụ rà quét và gỡ bỏ phần mềm Windows chuyên sâu",
    "en": "Deep Windows debloater and software removal toolkit"
  },
  "release": {
    "repo": "tsudev-org/tsucwico",
    "tagRegex": "^(?:(?:tsucwico|tsudev-cwico)-)?v(?<name>\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?)$",
    "sums": "SHA256SUMS.txt",
    "version": {
      "from": "tag",
      "rule": "VERSIONING.md 2.2 (v3): tag vYY.M.DDNN, version = tag without v (v26.11.1901 -> 26.11.1901); semver in manifests drops a leading zero on days 1-9 (v26.12.0301 -> 26.12.301). Tags up to 26.11.1002: semver = YY.M.(D*100+N), tsudev-cwico-v26.11.10.2 -> 26.11.1002",
      "tool": "tools/version.py to-semver <tag>"
    },
    "legacyTagPrefix": "tsudev-cwico"
  },
  "assets": {
    "windows-x64": {
      "file": "tsucwico_{version}_windows-x64-cli.exe",
      "kind": "portable",
      "bin": "tsucwico_{version}_windows-x64-cli.exe"
    },
    "windows-x64-installer": {
      "file": "tsucwico_{version}_windows-x64-setup.exe",
      "kind": "installer",
      "installer": "nullsoft"
    },
    "windows-x64-msi": {
      "file": "tsucwico_{version}_windows-x64.msi",
      "kind": "installer",
      "installer": "wix"
    }
  },
  "channels": [
    "winget",
    "scoop"
  ],
  "planned": []
}
